<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Complemento do ScannerVcIaRfid.Maui: registra motores extras de visao
         (objetos, rotulos, rostos) para o controle VisionScanner. Separado para
         que o app so embarque esses modelos se usar. Apenas Android por enquanto. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ScannerVcIaRfid.Maui.VisionExtras</RootNamespace>
    <AssemblyName>ScannerVcIaRfid.Maui.VisionExtras</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="..\ScannerVcIaRfid.Maui\ScannerVcIaRfid.Maui.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <ProjectReference Include="..\ScannerVcIaRfid.VisionExtras.Android.Binding\ScannerVcIaRfid.VisionExtras.Android.Binding.csproj" />
  </ItemGroup>

</Project>
