<Project Sdk="Microsoft.Android.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenSystemScanner.Android.Binding</RootNamespace>
    <AssemblyName>OpenSystemScanner.Android.Binding</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build Action = AndroidLibrary. No Visual Studio, clique com o botão direito no
         arquivo .aar -> Properties -> Build Action -> AndroidLibrary. Via CLI/csproj,
         é exatamente este item abaixo que faz o mesmo papel. -->
    <AndroidLibrary Include="Jars\opensystemscanner-release.aar" />
  </ItemGroup>

  <ItemGroup>
    <TransformFile Include="Transforms\Metadata.xml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dependências nativas transitivas do opensystemscanner-release.aar.
      O .aar embarca apenas o BYTECODE do nosso módulo; CameraX e ML Kit
      continuam sendo "implementation" no Gradle, ou seja, o consumidor
      (esta binding) precisa fornecer esses .aar/.jar em tempo de link.
      Confirme os números de versão exatos no NuGet.org - eles evoluem
      com frequência e devem casar (ou ser >=) com as versões nativas
      usadas no build.gradle.kts: CameraX 1.3.4, ML Kit Barcode 17.3.0,
      Lifecycle Runtime KTX 2.8.4.
    -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.3.4.*" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.3.4.*" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.3.4.*" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.3.4.*" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.8.4.*" />
    <PackageReference Include="Xamarin.Google.MLKit.BarcodeScanning" Version="17.3.0.*" />
  </ItemGroup>

</Project>
