<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScannerVcIaRfid.Nfc.Android.Binding</RootNamespace>
    <AssemblyName>ScannerVcIaRfid.Nfc.Android.Binding</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modulo nativo nfc. Gere com `./gradlew exportMauiAars` na raiz do
         repositorio - ver Jars/README.md. -->
    <AndroidLibrary Include="Jars\*.aar" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O modulo nfc usa so android.nfc e org.json (plataforma). A unica
      dependencia em runtime e a biblioteca padrao do Kotlin.
    -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
  </ItemGroup>

</Project>
