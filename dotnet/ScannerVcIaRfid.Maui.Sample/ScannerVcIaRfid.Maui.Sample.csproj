<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Etapa 8 foca exclusivamente em Android, assim como as etapas anteriores da ponte MAUI. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ScannerVcIaRfid.Maui.Sample</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>ScannerVcIaRfid Sample</ApplicationTitle>
    <ApplicationId>com.scannervciarfid.maui.sample</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Sem MauiIcon/MauiSplashScreen/MauiImage/MauiFont propositalmente - este
      projeto existe para provar a integracao de hardware/camera da Etapa 8,
      nao para ser um app publicavel. Adicione os assets de Resources\ quando
      este sample evoluir para um app real.
    -->
    <!-- Desde o .NET 8, UseMaui nao inclui mais os pacotes do MAUI sozinho (aviso MA002). -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- Necessario para builder.Logging.AddDebug() em MauiProgram.cs. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <ProjectReference Include="..\ScannerVcIaRfid.Maui\ScannerVcIaRfid.Maui.csproj" />
    <ProjectReference Include="..\ScannerVcIaRfid.Maui.Nfc\ScannerVcIaRfid.Maui.Nfc.csproj" />
  </ItemGroup>

</Project>
