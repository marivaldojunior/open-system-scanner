<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ScannerVcIaRfid.Maui.Controls"
             x:Class="ScannerVcIaRfid.Maui.Sample.MainPage"
             Title="ScannerVcIaRfid">

    <Grid RowDefinitions="Auto,300,Auto,Auto"
          Padding="16"
          RowSpacing="16">

        <Label x:Name="LastScanLabel"
               Grid.Row="0"
               Text="Nenhuma leitura ainda"
               FontSize="18"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />

        <controls:VisionScanner x:Name="CameraScannerView"
                                 Grid.Row="1"
                                 HeightRequest="300" />

        <Button x:Name="ActivateCameraButton"
                Grid.Row="2"
                Text="Ativar Câmera"
                Clicked="OnActivateCameraClicked" />

        <Label Grid.Row="3"
               Text="Ou pressione o gatilho físico do dispositivo"
               FontSize="14"
               TextColor="Gray"
               HorizontalTextAlignment="Center" />

    </Grid>

</ContentPage>
