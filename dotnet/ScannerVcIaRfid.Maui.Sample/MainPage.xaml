<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ScannerVcIaRfid.Maui.Controls"
             x:Class="ScannerVcIaRfid.Maui.Sample.MainPage"
             Title="ScannerVcIaRfid">

    <Grid RowDefinitions="Auto,300,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          Padding="16"
          RowSpacing="16">

        <Label x:Name="LastScanLabel"
               Grid.Row="0"
               Text="Nenhuma leitura ainda"
               FontSize="18"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />

        <controls:VisionScanner x:Name="CameraScannerView"
                                 Grid.Row="1"
                                 HeightRequest="300" />

        <Button x:Name="ActivateCameraButton"
                Grid.Row="2"
                Text="Ativar Câmera"
                Clicked="OnActivateCameraClicked" />

        <Button x:Name="SwitchEngineButton"
                Grid.Row="3"
                Text="Motor: Código de barras"
                Clicked="OnSwitchEngineClicked" />

        <Button Grid.Row="4"
                Text="Google Code Scanner"
                Clicked="OnCodeScannerClicked" />

        <Label x:Name="LastNfcLabel"
               Grid.Row="6"
               Text="Aproxime uma tag NFC"
               FontSize="14"
               HorizontalTextAlignment="Center" />

        <Button x:Name="RfidInventoryButton"
                Grid.Row="7"
                Text="Iniciar inventário RFID"
                Clicked="OnRfidInventoryClicked" />

        <Label x:Name="RfidLabel"
               Grid.Row="8"
               Text="RFID: 0 tags"
               FontSize="14"
               HorizontalTextAlignment="Center" />

        <Button x:Name="ReadTidButton"
                Grid.Row="11"
                Text="RFID: ler TID da última tag"
                Clicked="OnReadTidClicked" />

        <Button Grid.Row="9"
                Text="IA: entidades da última leitura"
                Clicked="OnExtractEntitiesClicked" />

        <Label x:Name="AiLabel"
               Grid.Row="10"
               Text="Leia um texto (OCR) ou código e toque acima"
               FontSize="14"
               HorizontalTextAlignment="Center" />

        <Label Grid.Row="5"
               Text="Ou pressione o gatilho físico do dispositivo"
               FontSize="14"
               TextColor="Gray"
               HorizontalTextAlignment="Center" />

    </Grid>

</ContentPage>
