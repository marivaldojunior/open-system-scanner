<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScannerVcIaRfid.Android.Binding</RootNamespace>
    <AssemblyName>ScannerVcIaRfid.Android.Binding</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build Action = AndroidLibrary. Um .aar por modulo nativo (core,
         barcode-hardware, vision, vision-barcode, vision-ocr, code-scanner). Gere todos com
         `./gradlew exportMauiAars` na raiz do repositorio - ver Jars/README.md. -->
    <AndroidLibrary Include="Jars\*.aar" />
  </ItemGroup>

  <ItemGroup>
    <TransformFile Include="Transforms\Metadata.xml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dependências nativas transitivas dos .aar em Jars/.
      Cada .aar embarca apenas o BYTECODE do seu módulo; CameraX e ML Kit
      continuam sendo dependências Gradle, ou seja, o consumidor
      (esta binding) precisa fornecer esses .aar/.jar em tempo de link.
      As versões devem casar (ou ser >=) com gradle/libs.versions.toml:
      CameraX 1.6.1, ML Kit Barcode 17.3.0, ML Kit Text Recognition 16.0.1,
      Lifecycle Runtime KTX 2.11.0, AndroidX Core 1.13.1.
      Atenção: os pacotes Xamarin.Google.MLKit.* usam o prefixo "1" na
      versão (ML Kit 17.3.0 = NuGet 117.3.0.x). Esses pacotes só oferecem
      assets para net9.0-android e net10.0-android - por isso o TFM é net10.
    -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1.*" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.*" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.*" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.1.*" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.*" />
    <PackageReference Include="Xamarin.Google.MLKit.BarcodeScanning" Version="117.3.0.*" />
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.*" />
    <!-- play-services-code-scanner 16.1.0 (modulo code-scanner). -->
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.*" />
    <!-- play-services-mlkit-document-scanner 16.0.0 (modulo document-scanner). -->
    <PackageReference Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.*" />

    <!--
      CameraX 1.6 / Lifecycle 2.11 sobem Fragment, Collection e Tracing para
      versoes em que as classes "-ktx" foram movidas para o artefato
      principal. O MAUI ainda referencia os pacotes "-ktx" antigos, e o D8
      falha com classe duplicada (ex.: androidx/fragment/app/FragmentKt).
      Alinhar os pacotes "-ktx" com as versoes resolvidas evita o conflito
      (avisos NU1608 no restore).
    -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
  </ItemGroup>

</Project>
