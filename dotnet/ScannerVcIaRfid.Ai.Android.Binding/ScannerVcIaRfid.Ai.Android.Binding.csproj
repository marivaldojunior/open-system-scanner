<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- ML Kit Entity Extraction exige API 26. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScannerVcIaRfid.Ai.Android.Binding</RootNamespace>
    <AssemblyName>ScannerVcIaRfid.Ai.Android.Binding</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modulo nativo ai-language. Gere com `./gradlew exportMauiAars` na raiz
         do repositorio - ver Jars/README.md. -->
    <AndroidLibrary Include="Jars\*.aar" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versoes alinhadas com gradle/libs.versions.toml (prefixo "1" do NuGet:
         ML Kit 17.0.6 = NuGet 117.0.6.x). Versoes exatas: a verificacao de
         dependencias Java do AndroidMavenLibrary nao aceita versao flutuante. -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
    <PackageReference Include="Xamarin.Google.MLKit.Language.Id" Version="117.0.6.9" />
    <PackageReference Include="Xamarin.Google.MLKit.Translate" Version="117.0.3.9" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O ML Kit Entity Extraction nao tem pacote NuGet. O AndroidMavenLibrary
      baixa o .aar do Google Maven no build; Bind="false" porque o C# so
      chama o modulo ai-language (LanguageAiClient), nunca o ML Kit direto.
    -->
    <AndroidMavenLibrary Include="com.google.mlkit:entity-extraction" Version="16.0.0-beta6" Repository="Google" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dependencias Java do entity-extraction. A verificacao do
      AndroidMavenLibrary so aceita PackageReference direto, mesmo quando o
      pacote ja chega de forma transitiva (pelo Translate). As versoes sao as
      que o NuGet ja resolve - todas >= as do POM do Google Maven.
    -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportApi" Version="4.1.1.1" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportBackendCct" Version="4.1.1.2" />
    <PackageReference Include="Xamarin.Google.Android.DataTransport.TransportRuntime" Version="4.1.1.1" />
    <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="118.10.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.10.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />
    <PackageReference Include="Xamarin.Firebase.Components" Version="119.0.1.3" />
    <PackageReference Include="Xamarin.Firebase.Encoders" Version="117.0.0.26" />
    <PackageReference Include="Xamarin.Firebase.Encoders.JSON" Version="118.0.1.19" />
    <PackageReference Include="Xamarin.Google.MLKit.Common" Version="118.11.0.9" />
    <PackageReference Include="Square.OkHttp3" Version="5.5.0" />
    <PackageReference Include="Square.OkIO" Version="3.18.1" />
    <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="2.4.0.1" />
    <!-- Mesmos pins da binding principal: os pacotes "-ktx" que o MAUI
         referencia ficaram para tras das versoes resolvidas (avisos NU1608 /
         classe duplicada no D8). -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
  </ItemGroup>

</Project>
