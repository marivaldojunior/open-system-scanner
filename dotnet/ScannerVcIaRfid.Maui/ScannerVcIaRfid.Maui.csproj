<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Etapa 6 foca exclusivamente em Android. Quando as implementacoes de
      iOS/Windows existirem, adicione os TFMs correspondentes aqui, por
      exemplo: net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0
    -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ScannerVcIaRfid.Maui</RootNamespace>
    <AssemblyName>ScannerVcIaRfid.Maui</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Desde o .NET 8, UseMaui nao inclui mais os pacotes do MAUI sozinho (aviso MA002). -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <ProjectReference Include="..\ScannerVcIaRfid.Android.Binding\ScannerVcIaRfid.Android.Binding.csproj" />
  </ItemGroup>

</Project>
